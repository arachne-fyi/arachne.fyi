{
  "name": "@arachne/server",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning src/index.ts",
    "build": "esbuild src/index.ts src/store/rebuild-cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --alias:@arachne/shared=../shared/src/index.ts --sourcemap",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "seed-year": "tsx --disable-warning=ExperimentalWarning scripts/seed-year.ts",
    "rebuild-index": "tsx --disable-warning=ExperimentalWarning src/store/rebuild-cli.ts",
    "rebuild-index:prod": "node --disable-warning=ExperimentalWarning dist/store/rebuild-cli.js",
    "purge": "tsx --disable-warning=ExperimentalWarning src/store/purge-cli.ts"
  },
  "dependencies": {
    "@arachne/shared": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.11",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
