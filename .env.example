# Copy to .env and fill in. Never commit .env.

# Where the dashboard is reached from browsers. Used for the Discord redirect and cookies.
# Local development: http://localhost:5173 (Vite) or http://localhost:8787 (built).
PUBLIC_URL=http://localhost:5173

# Discord login. discord.com/developers/applications > New Application > OAuth2.
# Add the redirect: <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your own Discord user ID (Discord settings > Advanced > Developer Mode, then right-click
# yourself > Copy User ID). Listed IDs are always admins; add friends from the Admin page.
ADMIN_DISCORD_IDS=

# Skip Discord on your own machine: shows a "log in as this name" form. Refused when
# PUBLIC_URL is https, so it cannot be left on by accident in production.
DEV_AUTH=1

# Show the landing page (not the dashboard) when the site is opened on this hostname.
LANDING_HOST=arachne.fyi

# Cloudflare Tunnel token, for docker compose (see docs/hosting.md).
TUNNEL_TOKEN=

# Optional
# PORT=8787
# DATA_DIR=./data
# BAZAAR_ENABLED=1
# BAZAAR_POLL_MS=300000
# Fill older and missed Bazaar prices from SkyCofl (sky.coflnet.com): on by default,
# 5 years back (daily points for old years, 2-hourly for the last 90 days, 5-minute for the
# last day), rechecked every 6 hours. Our own snapshots always win.
# COFL_BACKFILL=1
# COFL_BACKFILL_DAYS=1825
# SESSION_DAYS=30

# Post rare drops to a Discord channel: Channel settings > Integrations > Webhooks > New webhook,
# then paste its URL here. Leave empty to turn it off.
# DISCORD_WEBHOOK_URL=
# Any drop worth at least this many coins is posted too (Dark Queen's Soul, Fang and pets always are).
# RARE_DROP_MIN_COINS=1000000

# A copy of state.db (users, tokens, settings) is made every night. Point this at a second
# drive if you have one, e.g. D:/arachne-backups. Keeps the last 14.
# BACKUP_DIR=./data/backups

# Test server only. Lets an admin wipe all farming data (Admin page) and enables
# `npm run purge -- --yes` (add --everything to also remove accounts and groups).
# On an https address it also needs ALPHA_MODE_PUBLIC=1. Never set these on the real site.
# ALPHA_MODE=1
# ALPHA_MODE_PUBLIC=1
